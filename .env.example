# Copy to .env. npm start reads it automatically.
NODE_ENV=production
PORT=4173
LIVE_HOST=127.0.0.1
# LIVE_DATA_DIR defaults to the data folder in this project.
# LIVE_DATA_DIR=/path/to/private/data

# For a reverse proxy, set the exact public origin (no trailing slash).
# LIVE_ORIGIN=https://live.example.com
# LIVE_TRUST_PROXY=1

# Linux: install Chromium with the same variable before starting:
# PLAYWRIGHT_BROWSERS_PATH=0 npx playwright install --with-deps chromium
# PLAYWRIGHT_BROWSERS_PATH=0
